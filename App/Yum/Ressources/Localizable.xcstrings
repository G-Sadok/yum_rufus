    "prereglages.description": {
      "comment": "Cahier de developpement, section 9, description de la section Prereglages de lecture",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preset captures every reading setting below, the direction, the filters, the tint and the AI processing, then reapplies them in a single action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preajuste captura todos los ajustes de lectura de abajo, el sentido, los filtros, el tono y los procesos con IA, y los vuelve a aplicar en una sola acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prereglage capture tous les reglages de lecture ci dessous, le sens, les filtres, la teinte et les traitements IA, puis les reapplique en une seule action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットは以下の読書設定をすべて記録します。読む方向、フィルタ、色調、AI処理をまとめて、一度の操作で再適用できます。"
          }
        }
      }
    },
