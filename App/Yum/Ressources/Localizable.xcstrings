    "etatVide.bibliotheque.phrase": {
      "comment": "DESIGN-SPEC.md, tableau 6.3",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse the sources to find manga and add them to your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora las fuentes para encontrar mangas y añadirlos a tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez les sources pour trouver des mangas et les ajouter a votre bibliotheque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースを見て作品を探し、ライブラリに追加しましょう。"
          }
        }
      }
    },
    "etatVide.bibliotheque.titre": {
      "comment": "DESIGN-SPEC.md, tableau 6.3",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library is empty"
          }
        },
        "es": {
