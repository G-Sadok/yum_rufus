          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L historique n a pas pu etre lu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を読み込めませんでした"
          }
        }
      }
    },
    "erreur.reessayer": {
      "comment": "DESIGN-SPEC.md, tableau 6.5, bouton secondaire de tout etat d erreur",
      "extractionState": "manual",
      "localizations": {
        "en": {
