          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deuxieme carte Bibliotheque, comportement, distincte de la carte de tri plus haut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2枚目のライブラリカード、動作の設定です。上の並べ替えカードとは別のものです。"
          }
        }
      }
    },
    "reglages.description.bibliothequeTri": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sorting applies to the grid and to the compact list mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ordenación se aplica a la cuadrícula y al modo de lista compacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tri s applique a la grille et au mode liste compacte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この並べ替えはグリッドとコンパクトリスト表示に適用されます。"
          }
        }
      }
    },
    "reglages.description.confidentialite": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private browsing: the reading activity is not recorded in the history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegación privada: la actividad de lectura no se registra en el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation privee : l activite de lecture n est pas enregistree dans l historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベート閲覧。読書の記録は履歴に残りません。"
          }
        }
      }
    },
    "reglages.description.lecteur": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The double page folds back automatically in portrait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La doble página se repliega automáticamente en vertical."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La double page se replie automatiquement en portrait."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦向きでは見開き表示が自動的に単ページに戻ります。"
          }
        }
      }
    },
    "reglages.description.pontNavigateur": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge lets a catalog page open in the browser send a series to Yum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente permite que una página de catálogo abierta en el navegador envíe una serie a Yum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont laisse une page de catalogue ouverte dans le navigateur envoyer une serie vers Yum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジを使うと、ブラウザで開いているカタログページからシリーズをYumに送れます。"
          }
        }
      }
    },
    "reglages.description.stockage": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted chapters remain readable from their source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los capítulos eliminados siguen siendo legibles desde su fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chapitres supprimes restent lisibles depuis leur source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した章も、そのソースからは引き続き読めます。"
          }
        }
      }
