{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git show-ref:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh release:*)",
      "Bash(gh run:*)",
      "Bash(jq:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(xcodebuild:*)",
      "Bash(swiftlint:*)",
      "Bash(swiftformat:*)",
      "Bash(./scripts/boucle-demarrer.sh:*)",
      "Bash(./scripts/boucle-terminer.sh:*)",
      "Bash(./scripts/boucle-statut.sh:*)",
      "Bash(./scripts/verifications.sh:*)",
      "Bash(./scripts/build-dmg.sh:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(xcrun notarytool:*)",
      "Bash(gh release create:*)"
    ],
    "deny": [
      "Bash(git push origin dev:*)",
      "Bash(rm -rf /:*)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/*.p12)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hook-tiret-cadratin.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hook-protege-main.sh"
          }
        ]
      }
    ]
  }
}
