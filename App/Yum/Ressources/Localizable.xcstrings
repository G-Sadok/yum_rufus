{
  "sourceLanguage": "fr",
  "strings": {
    "banniere.reactivation.apresExpiration": {
      "comment": "Section 10 du cahier de developpement, degradation. Phrase absente de la section 6, ecrite selon ses regles. Nomme ce qui reste intact avant de proposer la sortie",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription ended on %@. Your series, your downloaded chapters and your settings are untouched. Resume Premium to download and publish your progress again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción terminó el %@. Tus series, tus capítulos descargados y tus ajustes siguen intactos. Reanuda Premium para volver a descargar y publicar tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a pris fin le %@. Vos series, vos chapitres telecharges et vos reglages sont intacts. Reprenez Premium pour telecharger et publier votre progression a nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは%@に終了しました。シリーズ、ダウンロード済みの章、設定はそのまま残っています。ダウンロードと進捗の公開を再開するにはPremiumを再開してください。"
          }
        }
      }
    },
    "banniere.reactivation.sansAbonnement": {
      "comment": "Section 10 du cahier de developpement, degradation. Cas d une source premium sans achat prealable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source requires Premium. You can read what is already here, Premium opens downloading and publishing your progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente requiere Premium. Puedes leer lo que ya está aquí, Premium habilita la descarga y la publicación de tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source demande Premium. Vous pouvez lire ce qui est deja la, Premium ouvre le telechargement et la publication de votre progression."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースにはPremiumが必要です。すでにある分は読めます。ダウンロードと進捗の公開はPremiumで利用できます。"
          }
        }
      }
    },
    "banniere.reactivation.titre": {
      "comment": "Section 10 du cahier de developpement, degradation. Le nom cite est celui de la source reelle, tableau 6.4",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is read only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en solo lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en lecture seule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は読み取り専用です"
          }
        }
      }
    },
