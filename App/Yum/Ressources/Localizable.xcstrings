    "erreur.boutique.phrase": {
      "comment": "DESIGN-SPEC.md, tableau 6.4, etat d erreur du mur premium",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum could not read the prices. Your current subscription, if you have one, stays active. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum no ha podido leer los precios. Tu suscripción actual, si la tienes, sigue activa. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum n a pas pu lire les tarifs. Votre abonnement actuel, s il existe, reste actif. Reessayez dans un moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumは価格を読み込めませんでした。現在のサブスクリプションがあれば有効なままです。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "erreur.boutique.titre": {
      "comment": "DESIGN-SPEC.md, tableau 6.4, etat d erreur du mur premium",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store is not responding"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tienda no responde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boutique ne repond pas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアが応答しません"
          }
        }
      }
    },
    "erreur.ficheDeSerie.phrase": {
      "comment": "DESIGN-SPEC.md, tableau 6.4. Le nom et le nombre sont les valeurs reelles",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ answered, then dropped the connection. The %2$lld downloaded chapters remain readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ respondió y después cortó la conexión. Los %2$lld capítulos descargados siguen siendo legibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a repondu, puis a coupe la connexion. Les %2$lld chapitres telecharges restent lisibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は応答した後に接続を切りました。ダウンロード済みの%2$lld章はそのまま読めます。"
          }
        }
      }
    },
    "erreur.ficheDeSerie.titre": {
      "comment": "DESIGN-SPEC.md, tableau 6.4",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chapter list could not be read"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la lista de capítulos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des chapitres n a pas pu etre lue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "章の一覧を読み込めませんでした"
          }
        }
      }
    },
    "erreur.historique.phrase": {
      "comment": "DESIGN-SPEC.md, tableau 6.4",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history file is corrupted. Yum can start it over, your library is untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de historial está dañado. Yum puede empezarlo de cero, tu biblioteca no se ve afectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d historique est corrompu. Yum peut le repartir de zero, votre bibliotheque n est pas touchee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴ファイルが破損しています。Yumは履歴を作り直せます。ライブラリには影響しません。"
          }
        }
      }
    },
    "erreur.historique.repartirDeZero": {
      "comment": "DESIGN-SPEC.md, tableau 6.4, seule action de cet etat d erreur",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start over"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar de cero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir de zero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初からやり直す"
          }
        }
      }
    },
    "erreur.historique.titre": {
      "comment": "DESIGN-SPEC.md, tableau 6.4",
      "extractionState": "manual",
      "localizations": {
        "en": {
