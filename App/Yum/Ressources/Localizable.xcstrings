    "verrouillage.aucunMoyen.phrase": {
      "comment": "Section 11 du cahier de developpement, appareil sans biometrie ni code. Nomme la cause et indique la sortie, tableau 6.4",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has neither Face ID nor a passcode. Add a passcode in the system settings to lock the application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene Face ID ni código. Añade un código en los ajustes del sistema para bloquear la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n a ni Face ID ni code. Ajoutez un code dans les reglages du systeme pour verrouiller l application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはFace IDもパスコードもありません。アプリをロックするには、システム設定でパスコードを追加してください。"
          }
        }
      }
    },
