    "reglages.description.aPropos": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum hosts no content. The application reads the files and the servers you point it to. You remain responsible for the legality of your sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum no aloja ningún contenido. La aplicación lee los archivos y los servidores que le indiques. Sigues siendo responsable de la legalidad de tus fuentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum ne heberge aucun contenu. L application lit les fichiers et les serveurs que vous lui indiquez. Vous restez responsable de la legalite de vos sources."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumはコンテンツを一切ホストしません。アプリは指定されたファイルとサーバーを読むだけです。ソースの合法性については利用者が責任を負います。"
          }
        }
      }
    },
    "reglages.description.abonnement": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock translation, colorization, tracking, backup, incognito mode, Komga, Kavita, Jellyfin and OPDS servers, iCloud sync and much more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea la traducción, el coloreado, los seguimientos, la copia de seguridad, el modo incógnito, los servidores Komga, Kavita, Jellyfin y OPDS, la sincronización con iCloud y mucho más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debloquez la traduction, la colorisation, les suivis, la sauvegarde, le mode incognito, les serveurs Komga, Kavita, Jellyfin et OPDS, la synchronisation iCloud et bien plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳、着色、トラッキング、バックアップ、シークレットモード、Komga、Kavita、Jellyfin、OPDSサーバー、iCloud同期などを利用できます。"
          }
        }
      }
    },
    "reglages.description.bibliothequeComportement": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, description sous une carte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Second Library card, behavior, distinct from the sorting card above."
