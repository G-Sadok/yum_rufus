        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Premium for seven days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba Premium durante siete días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez Premium pendant sept jours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiumを7日間試す"
          }
        }
      }
    },
    "premiereOuverture.etape.premiereSource.phrase": {
      "comment": "Texte absent de la section 6, ecrit selon ses regles",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Yum where to fetch your chapters. You can add more at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica dónde buscará Yum tus capítulos. Podrás añadir más cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez ou Yum ira chercher vos chapitres. Vous pourrez en ajouter d autres a tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumが章を取得する場所を指定します。あとからいつでも追加できます。"
          }
        }
      }
    },
    "premiereOuverture.etape.premiereSource.titre": {
      "comment": "Texte absent de la section 6, ecrit selon ses regles",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a first source"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una primera fuente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une premiere source"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のソースを追加"
          }
        }
      }
    },
    "premiereOuverture.etape.sensDeLecture.phrase": {
      "comment": "Texte absent de la section 6, ecrit selon ses regles",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manga reads right to left, manhwa and comics left to right, webtoons top to bottom. You can change this per series later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El manga se lee de derecha a izquierda, el manhwa y los comics de izquierda a derecha, los webtoons de arriba abajo. Podras cambiarlo serie por serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mangas se lisent de droite a gauche, les manhwas et les comics de gauche a droite, les webtoons de haut en bas. Vous pourrez changer ce choix serie par serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "漫画は右から左へ、マンファとコミックは左から右へ、ウェブトゥーンは上から下へ読みます。この選択はシリーズごとに変更できます。"
          }
        }
      }
    },
    "premiereOuverture.etape.sensDeLecture.titre": {
      "comment": "Texte absent de la section 6, ecrit selon ses regles",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your reading direction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu sentido de lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre sens de lecture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読む方向を選ぶ"
          }
        }
      }
    },
    "premiereOuverture.mention": {
      "comment": "DESIGN-SPEC.md, tableau 6.8, etape 2 de la premiere ouverture",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum hosts no content. It reads the files and the servers you point it to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum no aloja ningún contenido. Lee los archivos y los servidores que le indiques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yum ne heberge aucun contenu. Il lit les fichiers et les serveurs que vous lui indiquez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumはコンテンツを一切ホストしません。指定されたファイルとサーバーを読むだけです。"
          }
        }
      }
    },
