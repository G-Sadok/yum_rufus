    "premiereOuverture.etape.essaiPremium.phrase": {
      "comment": "Texte absent de la section 6, ecrit selon ses regles",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you just set up stays free. The trial opens the advanced features, and ends on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que acabas de configurar sigue siendo gratis. La prueba abre las funciones avanzadas y termina sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous venez de configurer reste gratuit. L essai ouvre les fonctions avancees, et se termine seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま設定した内容はすべて無料のままです。体験では高度な機能が使え、期間は自動で終了します。"
          }
        }
      }
    },
    "premiereOuverture.etape.essaiPremium.titre": {
      "comment": "Texte absent de la section 6, ecrit selon ses regles",
      "extractionState": "manual",
