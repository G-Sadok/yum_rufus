    "reglages.description.traduction": {
      "comment": "Cahier de developpement, section 9, description sous la carte Traduction",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On device translation is free and private. The cloud engine gives better results and uses credits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción en el dispositivo es gratuita y privada. El motor en la nube da mejores resultados y consume créditos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction sur l appareil est gratuite et privee. Le moteur dans le nuage donne de meilleurs resultats et consomme des credits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上での翻訳は無料でプライベートです。クラウドのエンジンはより良い結果を出しますが、クレジットを消費します。"
          }
        }
      }
    },
