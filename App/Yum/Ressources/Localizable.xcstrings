    },
    "erreur.reglages.ouvrirLesReglagesDuSysteme": {
      "comment": "DESIGN-SPEC.md, tableau 6.5, second bouton de la banniere de l ecran Reglages",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir los ajustes del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les reglages du systeme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        }
      }
    },
    "erreur.reglages.phrase": {
      "comment": "DESIGN-SPEC.md, tableau 6.4, banniere de l ecran Reglages",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud account on this device no longer allows Yum. Open the system settings, then turn Yum back on in the list of iCloud apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de iCloud de este dispositivo ya no autoriza a Yum. Abre los ajustes del sistema y vuelve a activar Yum en la lista de apps de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte iCloud de cet appareil n autorise plus Yum. Ouvrez les reglages du systeme, puis reactivez Yum dans la liste des applications iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのiCloudアカウントはYumを許可しなくなりました。システム設定を開き、iCloudのアプリ一覧でYumを再度オンにしてください。"
          }
        }
      }
    },
    "erreur.reglages.titre": {
      "comment": "DESIGN-SPEC.md, tableau 6.4, banniere de l ecran Reglages. Le nombre est la valeur reelle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud has not synced for %lld days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no se sincroniza desde hace %lld días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud n a pas synchronise depuis %lld jours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudは%lld日間同期していません"
          }
        }
      }
    },
    "etatVide.bibliotheque.action": {
      "comment": "DESIGN-SPEC.md, tableau 6.3",
      "extractionState": "manual",
      "localizations": {
