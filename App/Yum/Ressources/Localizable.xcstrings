    "statistiques.description.serie": {
      "comment": "Description sous la carte, section 4.2. Dit la regle sans la prescrire",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day counts when the goal is reached. Without a goal, one chapter is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día cuenta cuando se alcanza el objetivo. Sin objetivo, basta con un capítulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour compte quand l objectif est atteint. Sans objectif, un chapitre suffit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標を達成した日がカウントされます。目標がない場合は1章で十分です。"
          }
        }
