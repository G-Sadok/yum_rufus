    "reglages.note": {
      "comment": "DESIGN-SPEC.md, section 5.5, note en caption sous la carte A propos. La section 9 du cahier de developpement y attend la provenance et la licence du jeu de donnees du detecteur de cases. La valeur reprend mot pour mot CatalogueDesModelesIA.mentionDuDetecteurDeCases, et un test compare les deux",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel detection: detector of the project, trained on public domain plates from the Digital Comic Museum, annotations of the project published under the CC0 1.0 license."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detección de viñetas: detector del proyecto, entrenado con planchas de dominio público del Digital Comic Museum, anotaciones del proyecto publicadas bajo licencia CC0 1.0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection de cases : detecteur du projet, entraine sur des planches du domaine public du Digital Comic Museum, annotations du projet publiees sous licence CC0 1.0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマ検出。本プロジェクトの検出器を Digital Comic Museum のパブリックドメイン作品で学習させました。プロジェクトの注釈は CC0 1.0 ライセンスで公開しています。"
          }
        }
      }
    },
